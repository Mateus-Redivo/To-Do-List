<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.10</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.todolist</groupId>
	<artifactId>todolist-api</artifactId>
	<version>1.0.0-RELEASE</version>
	<name>todolist-api</name>
	<description>RESTful API for To-Do List management</description>
	<properties>
		<java.version>21</java.version>
		<jacoco.version>0.8.13</jacoco.version>
		<!-- Cobertura mínima exigida por 'mvn verify'. Ver docs/TESTS.md -->
		<jacoco.coverage.minimum>0.80</jacoco.coverage.minimum>
		<maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
		<maven-surefire-report-plugin.version>3.5.2</maven-surefire-report-plugin.version>
		<!--
			Precisa acompanhar a linha do Spring Boot: a série 2.5.x quebra com Spring Framework 6.2
			(NoSuchMethodError em ControllerAdviceBean), fazendo /v3/api-docs retornar 500.
		-->
		<springdoc.version>2.8.13</springdoc.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Banco em memória usado pelo profile 'test'; permite rodar a suíte sem MySQL -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				Javadoc navegável em HTML.
				  'mvn javadoc:javadoc' gera target/reports/apidocs/index.html
				doclint desligado: a documentação do projeto é descritiva e não usa @param/@return
				em todo método, o que faria o javadoc do JDK 21 reprovar a geração.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${maven-javadoc-plugin.version}</version>
				<configuration>
					<doclint>none</doclint>
					<encoding>UTF-8</encoding>
					<docencoding>UTF-8</docencoding>
					<charset>UTF-8</charset>
					<doctitle>To-Do List API — ${project.version}</doctitle>
					<windowtitle>To-Do List API</windowtitle>
					<show>protected</show>
				</configuration>
			</plugin>

			<!--
				Relatório HTML dos testes.
				  'mvn surefire-report:report' roda os testes e gera target/reports/surefire.html
				  'mvn surefire-report:report-only' apenas gera o HTML a partir da última execução
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-report-plugin</artifactId>
				<version>${maven-surefire-report-plugin.version}</version>
			</plugin>

			<!--
				Cobertura de testes.
				  - 'mvn test'   gera o relatório em target/site/jacoco/index.html
				  - 'mvn verify' além disso reprova o build abaixo da cobertura mínima
				Classes sem lógica de negócio (bootstrap e configuração) ficam de fora da medição.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<exclude>com/todolist/api/TodolistApiApplication.class</exclude>
						<exclude>com/todolist/api/config/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.coverage.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
