# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env na raiz do projeto e configure suas próprias senhas
# NUNCA commitar o arquivo .env no Git!

# Configurações do MySQL
MYSQL_ROOT_PASSWORD=SUA_SENHA_ROOT_MYSQL
MYSQL_DATABASE=SEU_BANCO_DE_DADOS
MYSQL_USER=SEU_USUARIO_MYSQL
MYSQL_PASSWORD=SUA_SENHA_MYSQL_USUARIO

# Configurações do Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SUA_SENHA_ADMIN_AQUI

# Outras configurações sensíveis podem ser adicionadas aqui
# JWT_SECRET=seu_jwt_secret_muito_seguro
# EMAIL_PASSWORD=sua_senha_email
